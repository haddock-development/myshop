DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Stripe Payments
STRIPE_ENABLED=true
STRIPE_TESTMODE=true
STRIPE_TEST_PUBLISHABLE_KEY='pk_test_xxxxxxxxxxxxxxxxxxxxx'
STRIPE_TEST_SECRET_KEY='sk_test_xxxxxxxxxxxxxxxxxxxxx'
STRIPE_LIVE_PUBLISHABLE_KEY='pk_live_xxxxxxxxxxxxxxxxxxxxx'
STRIPE_LIVE_SECRET_KEY='sk_live_xxxxxxxxxxxxxxxxxxxxx'
STRIPE_TEST_WEBHOOK_SECRET='whsec_test_xxxxxxxxxxxxxxxxxxxxx'
STRIPE_WEBHOOK_SECRET='whsec_live_xxxxxxxxxxxxxxxxxxxxx'
STRIPE_ENABLE_GOOGLE_PAY=true
# Optional button overrides
# STRIPE_PAYMENT_REQUEST_BUTTON_TYPE='default'
# STRIPE_PAYMENT_REQUEST_BUTTON_THEME='dark'
# STRIPE_PAYMENT_REQUEST_BUTTON_LABEL='Buy now'

# AP2 Gateway (Agent Payments Protocol)
AP2_ENABLED=false
AP2_API_TOKEN='change-me-ap2-token'
AP2_STATEMENT_DESCRIPTOR='MYSHOP AP2'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
